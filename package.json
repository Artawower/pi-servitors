{
  "name": "pi-servitors",
  "version": "0.5.0",
  "description": "Persistent Pi servitor orchestration with pluggable worker hosts and event-driven pi-link callbacks.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "multi-agent",
    "workers",
    "herdr",
    "tmux"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./node_modules/pi-link/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-link": "0.5.0",
    "pi-open-agents": "0.1.22"
  },
  "bundledDependencies": [
    "pi-link",
    "pi-open-agents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/*.test.ts"
  },
  "files": [
    "src",
    "README.md",
    "agents",
    "skills",
    "docs"
  ]
}
